# n8n Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# n8n Server Configuration
# ============================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Webhook URL (used for external webhooks)
# Change to your server IP or domain for production
WEBHOOK_URL=http://localhost:5678

# Timezone for workflow executions
GENERIC_TIMEZONE=Africa/Lagos

# ============================================
# Security (Recommended for Production)
# ============================================
# Enable basic authentication
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_password_here

# Encryption key for credentials (generate a random string)
N8N_ENCRYPTION_KEY=your_random_encryption_key_here

# ============================================
# Satellite Kitchen Integrations
# ============================================

# Chowdeck API (for order management)
CHOWDECK_API_URL=https://api.chowdeck.co.uk
CHOWDECK_TOKEN=your_chowdeck_jwt_token_here

# Supabase (for database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ============================================
# WhatsApp Notifications (via Twilio)
# ============================================
# Recommended provider: Twilio WhatsApp API
# Sign up at: https://www.twilio.com/try-twilio

# Twilio Account Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# WhatsApp API URL (Twilio)
WHATSAPP_API_URL=https://api.twilio.com/2010-04-01/Accounts/{TWILIO_ACCOUNT_SID}/Messages.json

# Chef WhatsApp number (for order notifications)
# Format: +234XXXXXXXXXX (Nigerian format)
CHEF_PHONE=+234XXXXXXXXXX

# Manager WhatsApp number (for failure alerts)
# Format: +234XXXXXXXXXX (Nigerian format)
MANAGER_PHONE=+234XXXXXXXXXX

# ============================================
# Alternative: WhatsApp Business API (Meta)
# ============================================
# Uncomment and use if using Meta's official API instead of Twilio
# WHATSAPP_BUSINESS_API_URL=https://graph.facebook.com/v18.0/{PHONE_NUMBER_ID}/messages
# WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
