    {
      "parameters": {
        "jsCode": "// Validate webhook signature\nconst crypto = require('crypto');\n\nconst payload = JSON.stringify($input.first().json);\nconst signature = $input.first().headers?.['x-chowdeck-signature'] || $input.first().headers?.['X-Chowdeck-Signature'];\nconst secret = $env.WEBHOOK_SECRET;\n\nif (!secret) {\n  console.log('WEBHOOK_SECRET not set, skipping validation');\n  return [{\n    json: {\n      validated: true,\n      payload: $input.first().json,\n      warning: 'Webhook secret not configured'\n    }\n  }];\n}\n\nif (!signature) {\n  return [{\n    json: {\n      validated: false,\n      error: 'Missing webhook signature',\n      payload: $input.first().json\n    }\n  }];\n}\n\n// Compute expected signature\nconst expectedSignature = crypto\n  .createHmac('sha256', secret)\n  .update(payload)\n  .digest('hex');\n\n// Compare signatures (timing-safe)\nconst isValid = crypto.timingSafeEqual(\n  Buffer.from(signature),\n  Buffer.from(expectedSignature)\n);\n\nreturn [{\n  json: {\n    validated: isValid,\n    payload: $input.first().json,\n    error: isValid ? null : 'Invalid webhook signature'\n  }\n}];"
      },
      "id": "validate-webhook",
      "name": "Validate Webhook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-valid",
              "leftValue": "={{ $json.validated }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-valid",
      "name": "If Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse and route webhook event\nconst payload = $input.first().json.payload;\nconst eventType = payload.event || payload.event_type || payload.type;\n\n// Supported events\nconst supportedEvents = [\n  'order_picked_up',\n  'order_arrived_at_customer',\n  'order_complete',\n  'delivery_status_updated'\n];\n\nif (!supportedEvents.includes(eventType)) {\n  return [{\n    json: {\n      handled: false,\n      event_type: eventType,\n      reason: 'Unsupported event type',\n      payload: payload\n    }\n  }];\n}\n\n// Extract order/delivery info\nconst orderId = payload.order_id || payload.order?.id;\nconst deliveryId = payload.delivery_id || payload.delivery?.id || payload.order?.delivery_id;\nconst deliveryStatus = payload.delivery_status || payload.status || payload.delivery?.status;\n\n// Map event to order status\nconst eventStatusMap = {\n  'order_picked_up': {\n    order_status: 'rider_left',\n    delivery_status: 'picked_up',\n    message: 'Rider has picked up the order'\n  },\n  'order_arrived_at_customer': {\n    order_status: 'rider_arrived',\n    delivery_status: 'arrived',\n    message: 'Rider has arrived at customer location'\n  },\n  'order_complete': {\n    order_status: 'delivered',\n    delivery_status: 'delivered',\n    message: 'Order has been delivered successfully'\n  },\n  'delivery_status_updated': {\n    order_status: null, // Will be determined from delivery_status\n    delivery_status: deliveryStatus,\n    message: 'Delivery status updated'\n  }\n};\n\nconst mapping = eventStatusMap[eventType];\n\n// For generic status updates, map the delivery status\nif (eventType === 'delivery_status_updated' && deliveryStatus) {\n  const statusMap = {\n    'rider_assigned': 'preparing',\n    'picked_up': 'rider_left',\n    'in_transit': 'rider_left',\n    'arrived': 'rider_arrived',\n    'delivered': 'delivered',\n    'completed': 'delivered'\n  };\n  mapping.order_status = statusMap[deliveryStatus] || null;\n}\n\nreturn [{\n  json: {\n    handled: true,\n    event_type: eventType,\n    order_id: orderId,\n    delivery_id: deliveryId,\n    new_order_status: mapping.order_status,\n    new_delivery_status: mapping.delivery_status,\n    message: mapping.message,\n    rider_name: payload.rider?.name || payload.driver?.name || null,\n    rider_phone: payload.rider?.phone || payload.driver?.phone || null,\n    location: payload.location || payload.current_location || null,\n    eta: payload.eta || payload.estimated_arrival || null,\n    timestamp: payload.timestamp || new Date().toISOString(),\n    raw_payload: payload\n  }\n}];"
      },
