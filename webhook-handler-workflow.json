    {
      "parameters": {
        "jsCode": "// Format WhatsApp notification based on event type\nconst event = $('Parse Webhook Event').item.json;\nconst order = $input.first().json[0];\n\nconst statusEmojis = {\n  'rider_left': '🛵',\n  'rider_arrived': '📍',\n  'delivered': '✅',\n  'preparing': '👨‍🍳'\n};\n\nconst emoji = statusEmojis[event.new_order_status] || '📦';\n\nlet riderInfo = '';\nif (event.rider_name) {\n  riderInfo = `\\n👤 Rider: ${event.rider_name}`;\n  if (event.rider_phone) {\n    riderInfo += `\\n📞 Phone: ${event.rider_phone}`;\n  }\n}\n\nlet locationInfo = '';\nif (event.location) {\n  const lat = event.location.lat || event.location.latitude;\n  const lng = event.location.lng || event.location.longitude;\n  if (lat && lng) {\n    locationInfo = `\\n📍 Location: https://maps.google.com/?q=${lat},${lng}`;\n  }\n}\n\nlet etaInfo = '';\nif (event.eta) {\n  const etaTime = new Date(event.eta).toLocaleTimeString('en-NG', { hour: '2-digit', minute: '2-digit' });\n  etaInfo = `\\n⏰ ETA: ${etaTime}`;\n}\n\nconst message = `${emoji} *WEBHOOK ALERT* ${emoji}\\n\\n📋 Order: #${event.order_id}\\n👤 Customer: ${order.customer_name}\\n\\n🚚 *${event.message}*${riderInfo}${locationInfo}${etaInfo}\\n\\n⏰ ${new Date().toLocaleTimeString('en-NG', { hour: '2-digit', minute: '2-digit' })}`;\n\nreturn [{\n  json: {\n    message: message,\n    order_id: event.order_id,\n    recipient: $env.CHEF_PHONE,\n    event_type: event.event_type,\n    status: event.new_order_status\n  }\n}];"
      },
