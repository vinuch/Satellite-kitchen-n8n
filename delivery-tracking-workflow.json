          ],
          "combinator": "and"
        }
      },
      "id": "if-has-orders",
      "name": "If Has Orders?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batches",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [850, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CHOWDECK_API_URL }}/delivery/{{ $json.delivery_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.CHOWDECK_MERCHANT_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-delivery-status",
      "name": "Fetch Delivery Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "jsCode": "// Map Chowdeck delivery status to internal order status\nconst delivery = $input.first().json;\nconst order = $('Split In Batches').item.json;\n\n// Delivery status from Chowdeck\nconst deliveryStatus = delivery.status || delivery.delivery_status || 'unknown';\nconst previousStatus = order.delivery_status || 'unknown';\n\n// Status mapping\nconst statusMap = {\n  'rider_assigned': 'preparing',\n  'rider_at_vendor': 'preparing',\n  'picked_up': 'rider_left',\n  'in_transit': 'rider_left',\n  'arrived': 'delivered',\n  'delivered': 'delivered',\n  'completed': 'delivered',\n  'cancelled': 'cancelled'\n};\n\nconst newOrderStatus = statusMap[deliveryStatus] || order.status;\nconst statusChanged = deliveryStatus !== previousStatus;\n\n// Extract rider info if available\nconst riderName = delivery.rider?.name || delivery.rider_name || order.rider_name;\nconst riderPhone = delivery.rider?.phone || delivery.rider_phone || order.rider_phone;\n\nreturn [{\n  json: {\n    order_id: order.id,\n    external_order_id: order.external_order_id,\n    delivery_id: order.delivery_id,\n    previous_delivery_status: previousStatus,\n    new_delivery_status: deliveryStatus,\n    previous_order_status: order.status,\n    new_order_status: newOrderStatus,\n    status_changed: statusChanged,\n    rider_name: riderName,\n    rider_phone: riderPhone,\n    customer_name: order.customer_name,\n    customer_phone: order.customer_phone,\n    delivery_address: order.delivery_address,\n    eta: delivery.estimated_arrival || delivery.eta || null,\n    location_lat: delivery.current_location?.lat || null,\n    location_lng: delivery.current_location?.lng || null\n  }\n}];"
      },
      "id": "map-status",
      "name": "Map Delivery Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-status-changed",
              "leftValue": "={{ $json.status_changed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-status-changed",
      "name": "If Status Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1450, 200]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "orders",
        "filters": {
          "conditions": [
            {
              "column": "id",
              "operator": "eq",
              "value": "={{ $json.order_id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "={{ $json.new_order_status }}"
            },
            {
              "fieldId": "delivery_status",
              "fieldValue": "={{ $json.new_delivery_status }}"
            },
            {
              "fieldId": "rider_name",
              "fieldValue": "={{ $json.rider_name }}"
            },
            {
              "fieldId": "rider_phone",
              "fieldValue": "={{ $json.rider_phone }}"
            },
            {
              "fieldId": "updated_at",
              "fieldValue": "={{ $now }}"
            }
          ]
        }
      },
      "id": "update-order-status",
      "name": "Update Order Status",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1650, 100],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Format WhatsApp message for chef about delivery status change\nconst data = $input.first().json;\n\nconst statusEmojis = {\n  'preparing': '👨‍🍳',\n  'rider_left': '🛵',\n  'delivered': '✅',\n  'cancelled': '❌'\n};\n\nconst statusMessages = {\n  'preparing': 'Rider assigned and on the way to pickup',\n  'rider_left': 'Rider has picked up the order and is on the way to customer',\n  'delivered': 'Order has been delivered to customer',\n  'cancelled': 'Delivery has been cancelled'\n};\n\nconst emoji = statusEmojis[data.new_order_status] || '📦';\nconst statusMsg = statusMessages[data.new_order_status] || `Status: ${data.new_order_status}`;\n\nlet riderInfo = '';\nif (data.rider_name) {\n  riderInfo = `\\n👤 Rider: ${data.rider_name}`;\n  if (data.rider_phone) {\n    riderInfo += `\\n📞 Rider Phone: ${data.rider_phone}`;\n  }\n}\n\nlet etaInfo = '';\nif (data.eta) {\n  const etaTime = new Date(data.eta).toLocaleTimeString('en-NG', { hour: '2-digit', minute: '2-digit' });\n  etaInfo = `\\n⏰ ETA: ${etaTime}`;\n}\n\nconst message = `${emoji} *DELIVERY UPDATE* ${emoji}\\n\\n📋 Order: #${data.external_order_id}\\n👤 Customer: ${data.customer_name}\\n\\n🚚 *${statusMsg}*${riderInfo}${etaInfo}\\n\\n⏰ Updated: ${new Date().toLocaleTimeString('en-NG', { hour: '2-digit', minute: '2-digit' })}`;\n\nreturn [{\n  json: {\n    message: message,\n    order_id: data.external_order_id,\n    recipient: $env.CHEF_PHONE,\n    status: data.new_order_status,\n    delivery_id: data.delivery_id\n  }\n}];"
      },
      "id": "format-whatsapp-message",
      "name": "Format WhatsApp Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1850, 100]
    },
    {
      "parameters": {
