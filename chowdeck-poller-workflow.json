    {
      "parameters": {
        "jsCode": "// Check if this is a website order without delivery_id\n// Website orders without delivery need manual booking\nconst order = $('Split In Batches').item.json;\n\n// Determine source - could be in payload or inferred\nconst sourcePayload = order.source_payload || {};\nconst orderSource = sourcePayload.source || 'chowdeck';\n\n// Check conditions\nconst isWebsiteOrder = orderSource === 'website';\nconst hasNoDelivery = !order.delivery_id;\n\n// Skip if website order with no delivery (admin will book manually)\nconst shouldSkip = isWebsiteOrder && hasNoDelivery;\n\nreturn [{\n  json: {\n    ...order,\n    source: orderSource,\n    should_skip: shouldSkip,\n    skip_reason: shouldSkip ? 'Website order without delivery - manual booking required' : null\n  }\n}];"
      },
