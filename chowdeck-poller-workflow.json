      "name": "HTTP Request - Chowdeck Orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Transform Chowdeck API response to standardized format\nconst response = $input.first().json;\n\n// Handle empty response\nif (!response || !response.data || !Array.isArray(response.data) || response.data.length === 0) {\n  return [{\n    json: {\n      orders: [],\n      count: 0,\n      empty: true\n    }\n  }];\n}\n\nconst orders = response.data\n  .filter(order => order && (order.id || order.order_id)) // Skip orders with null/undefined external_order_id\n  .map(order => ({\n    external_order_id: order.id || order.order_id,\n    status: order.status || 'received',\n    customer_name: order.customer?.name || order.customer_name || 'Unknown',\n    customer_phone: order.customer?.phone || order.customer_phone || null,\n    currency: order.currency || 'NGN',\n    total_amount: parseFloat(order.total_amount || order.total || 0) / 100, // Convert kobo to NGN\n    delivery_address: order.delivery_address || order.address || null,\n    source_payload: order,\n    // Delivery tracking fields\n    delivery_id: order.delivery_id || order.delivery?.id || null,\n    delivery_status: order.delivery?.status || null,\n    rider_name: order.delivery?.rider?.name || order.rider?.name || null,\n    rider_phone: order.delivery?.rider?.phone || order.rider?.phone || null,\n    items: (order.items || order.order_items || []).map(item => ({\n      item_name: item.name || item.item_name,\n      quantity: parseInt(item.quantity || 1),\n      unit_price: parseFloat(item.unit_price || item.price || 0) / 100, // Convert kobo to NGN\n      raw_payload: item\n    }))\n  }));\n\nreturn [{\n  json: {\n    orders: orders,\n    count: orders.length,\n    empty: false\n  }\n}];"
      },
      "id": "transform-orders",
      "name": "Transform Orders",
      "type": "n8n-nodes-base.code",
